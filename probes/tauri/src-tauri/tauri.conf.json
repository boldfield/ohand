{
  "productName": "ohand-tauri-probe",
  "version": "0.1.0",
  "identifier": "com.boldfield.ohand.tauri-probe",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Oh And Tauri Probe",
        "width": 400,
        "height": 600,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [],
    "resources": []
  }
}
